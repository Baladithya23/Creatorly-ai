# Required environment variables for ViralMind
# Copy this file to .env.local and fill in your real values
# Never commit .env.local to version control

# Groq API Key — get yours at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Hindsight Cloud API Key — get yours at https://ui.hindsight.vectorize.io
HINDSIGHT_API_KEY=your_hindsight_api_key_here

# Hindsight Memory Bank ID — the memory bank ID from your Hindsight dashboard
HINDSIGHT_BANK_ID=your_hindsight_bank_id_here

# YouTube Data API v3 Key — get yours at https://console.cloud.google.com
YOUTUBE_API_KEY=your_youtube_api_key_here
